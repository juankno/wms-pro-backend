generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
}

enum Role {
  operator
  supervisor
  admin
}

enum OrderStatus {
  pending
  in_progress
  completed
  cancelled
}

enum Priority {
  low
  medium
  high
}

enum MovementType {
  opening_balance
  purchase_receipt
  customer_return
  transfer_in
  order_shipment
  transfer_out
  adjustment_increase
  adjustment_decrease
  relocation
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(active)
  plan      String       @default("trial")
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users          User[]
  warehouses     Warehouse[]
  products       Product[]
  warehouseStock WarehouseStock[]
  stockMovements StockMovement[]
  pickingOrders  PickingOrder[]
  packingOrders  PackingOrder[]
  activityLogs   ActivityLog[]
  auditLogs      AuditLog[]
  roles          TenantRole[]
  invitations    UserInvitation[]
  locations      Location[]
  locationStock  LocationStock[]
  partners       Partner[]
  barcodes       ProductBarcode[]
  lots           Lot[]
  lotStock       LotStock[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  customFields   CustomFieldDefinition[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  username     String
  name         String
  email        String
  password     String
  role         Role     @default(operator)
  customRoleId String?
  warehouseId  String?
  pushToken    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])
  refreshTokens   RefreshToken[]
  assignedPicking PickingOrder[]   @relation("PickingAssignee")
  createdPicking  PickingOrder[]   @relation("PickingCreator")
  assignedPacking PackingOrder[]   @relation("PackingAssignee")
  createdPacking  PackingOrder[]   @relation("PackingCreator")
  purchaseOrders  PurchaseOrder[]
  receipts        Receipt[]
  stockMovements  StockMovement[]
  activityLogs    ActivityLog[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  customRole      TenantRole?      @relation(fields: [customRoleId], references: [id])
  sentInvitations UserInvitation[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  warehouseStock WarehouseStock[]
  pickingOrders  PickingOrder[]
  packingOrders  PackingOrder[]
  stockMovements StockMovement[]
  invitations    UserInvitation[]
  locations      Location[]
  locationStock  LocationStock[]
  lotStock       LotStock[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  tenant         Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("warehouses")
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  code          String
  name          String
  description   String   @default("")
  category      String
  barcode       String?
  unit          String   @default("UND")
  brand         String?
  compatibility String[] @default([])
  imageUrl      String?
  photos        String[] @default([])
  // Lot-tracked products need a lot on every receipt and ship first-expired-first-out.
  lotTracking   Boolean  @default(false)
  customFields  Json     @default("{}")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouseStock WarehouseStock[]
  locationStock  LocationStock[]
  stockMovements StockMovement[]
  pickingItems   PickingItem[]
  packingItems   PackingItem[]
  barcodes       ProductBarcode[]
  lots           Lot[]
  lotStock       LotStock[]
  purchaseItems  PurchaseOrderItem[]
  receiptLines   ReceiptLine[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, barcode])
  @@map("products")
}

model WarehouseStock {
  id          String @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  location    String @default("")
  minStock    Int    @default(0)
  onHand      Int    @default(0)
  reserved    Int    @default(0)
  // Units taken off the shelves by picking that have not shipped yet.
  picked      Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId, warehouseId])
  @@map("warehouse_stock")
}

model StockMovement {
  id             String       @id @default(uuid())
  tenantId       String
  productId      String
  warehouseId    String
  type           MovementType
  quantity       Int
  onHandBefore   Int
  onHandAfter    Int
  reservedBefore Int
  reservedAfter  Int
  referenceType  String?
  referenceId    String?
  notes          String?
  operatorId     String
  operatorName   String
  // Source (or the only) location involved; toLocationId is the destination of relocations.
  locationId     String?
  toLocationId   String?
  lotId          String?
  createdAt      DateTime     @default(now())

  product    Product   @relation(fields: [productId], references: [id])
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  operator   User      @relation(fields: [operatorId], references: [id])
  location   Location? @relation("MovementLocation", fields: [locationId], references: [id], onDelete: SetNull)
  toLocation Location? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  lot        Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([productId, warehouseId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model PickingOrder {
  id           String      @id @default(uuid())
  tenantId     String
  reference    String
  // Name shown on the order; a snapshot of the customer's name when customerId is set.
  client       String
  customerId   String?
  warehouseId  String
  status       OrderStatus @default(pending)
  priority     Priority    @default(medium)
  assignedToId String?
  createdById  String
  notes        String?
  photos       String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  completedAt  DateTime?
  cancelledAt  DateTime?

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  assignedTo   User?         @relation("PickingAssignee", fields: [assignedToId], references: [id])
  createdBy    User          @relation("PickingCreator", fields: [createdById], references: [id])
  items        PickingItem[]
  packingOrder PackingOrder?
  customer     Partner?      @relation(fields: [customerId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, reference])
  @@index([warehouseId, status])
  @@map("picking_orders")
}

model PickingItem {
  id               String  @id @default(uuid())
  pickingOrderId   String
  productId        String
  productCode      String
  productName      String
  quantity         Int
  pickedQuantity   Int     @default(0)
  reservedQuantity Int     @default(0)
  location         String  @default("")
  barcode          String?
  unit             String  @default("UND")
  notes            String?

  pickingOrder PickingOrder     @relation(fields: [pickingOrderId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id])
  lots         PickingItemLot[]

  @@map("picking_items")
}

model PackingOrder {
  id             String      @id @default(uuid())
  tenantId       String
  pickingOrderId String      @unique
  reference      String
  client         String
  warehouseId    String
  status         OrderStatus @default(pending)
  assignedToId   String?
  createdById    String
  notes          String?
  photos         String[]    @default([])
  totalWeight    Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  pickingOrder PickingOrder  @relation(fields: [pickingOrderId], references: [id])
  assignedTo   User?         @relation("PackingAssignee", fields: [assignedToId], references: [id])
  createdBy    User          @relation("PackingCreator", fields: [createdById], references: [id])
  items        PackingItem[]
  boxes        PackingBox[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, reference])
  @@index([warehouseId, status])
  @@map("packing_orders")
}

model PackingItem {
  id             String  @id @default(uuid())
  packingOrderId String
  productId      String
  productCode    String
  productName    String
  quantity       Int
  packedQuantity Int     @default(0)
  barcode        String?
  unit           String  @default("UND")
  boxId          String?

  packingOrder PackingOrder @relation(fields: [packingOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  box          PackingBox?  @relation(fields: [boxId], references: [id])

  @@map("packing_items")
}

model PackingBox {
  id             String  @id @default(uuid())
  packingOrderId String
  label          String
  weight         Float?
  sealed         Boolean @default(false)

  packingOrder PackingOrder  @relation(fields: [packingOrderId], references: [id], onDelete: Cascade)
  items        PackingItem[]

  @@map("packing_boxes")
}

model ActivityLog {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String
  orderType   String
  action      String
  detail      String
  operator    String
  userId      String
  warehouseId String
  timestamp   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([orderId, orderType])
  @@map("activity_logs")
}

model AuditLog {
  id               String   @id @default(uuid())
  tenantId         String
  actorId          String
  actorName        String
  action           String
  resource         String
  resourceId       String?
  route            String
  statusCode       Int
  payload          Json?
  requestId        String?
  ip               String?
  // Set when a platform admin acted through a support session.
  impersonatorId   String?
  impersonatorName String?
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, resource, resourceId])
  @@map("audit_logs")
}

// Operators of the SaaS itself; they manage tenants and never belong to one.
model PlatformAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

// Actions of platform admins. Kept without foreign keys so entries outlive the records they mention.
model PlatformAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String
  tenantId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

// Tenant-defined role; when assigned it replaces the permissions of the user's base role.
model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  invitations UserInvitation[]

  @@unique([tenantId, name])
  @@map("tenant_roles")
}

// Pending access for a person who will choose their own username and password.
// Only the hash of the token is stored; the token itself travels in the email link.
model UserInvitation {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  role         Role      @default(operator)
  customRoleId String?
  warehouseId  String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  invitedBy  User        @relation(fields: [invitedById], references: [id])
  customRole TenantRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@map("user_invitations")
}

enum LocationType {
  zone
  aisle
  rack
  level
  bin
  dock
  staging
}

// Physical place inside a warehouse. Codes are unique per warehouse and usually encode the path (A-01-2).
model Location {
  id           String       @id @default(uuid())
  tenantId     String
  warehouseId  String
  parentId     String?
  code         String
  name         String?
  type         LocationType
  // Whether stock can be stored here; structural levels (zone, aisle, rack) usually cannot.
  storable     Boolean      @default(true)
  // Maximum units; null means unlimited.
  capacity     Int?
  // Walking order used to sort picking routes.
  pickSequence Int          @default(0)
  customFields Json         @default("{}")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  parent        Location?       @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]      @relation("LocationTree")
  stock         LocationStock[]
  receiptLines  ReceiptLine[]
  movementsFrom StockMovement[] @relation("MovementLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")

  @@unique([warehouseId, code])
  @@index([tenantId, warehouseId, parentId])
  @@map("locations")
}

// Units of a product stored in a location. WarehouseStock keeps the warehouse totals:
// onHand = sum of these quantities + picked + stock not assigned to any location.
model LocationStock {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  locationId  String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([tenantId, warehouseId, productId])
  @@index([locationId])
  @@map("location_stock")
}

// Customer and/or supplier of the tenant; one company can be both.
model Partner {
  id           String   @id @default(uuid())
  tenantId     String
  code         String
  name         String
  taxId        String?
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  contactName  String?
  notes        String?
  isCustomer   Boolean  @default(false)
  isSupplier   Boolean  @default(false)
  customFields Json     @default("{}")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  pickingOrders  PickingOrder[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("partners")
}

// Extra barcodes of a product, e.g. the code printed on a box of 12 (quantity = 12 base units).
// Codes are unique per tenant together with Product.barcode.
model ProductBarcode {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  code      String
  quantity  Int      @default(1)
  label     String?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([productId])
  @@map("product_barcodes")
}

model Lot {
  id        String    @id @default(uuid())
  tenantId  String
  productId String
  code      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  product   Product          @relation(fields: [productId], references: [id])
  stock     LotStock[]
  picks     PickingItemLot[]
  movements StockMovement[]

  @@unique([productId, code])
  @@index([tenantId, expiresAt])
  @@map("lots")
}

// Units of a lot in a warehouse. For lot-tracked products the lots add up to onHand - picked.
model LotStock {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  lotId       String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lot       Lot       @relation(fields: [lotId], references: [id])

  @@unique([lotId, warehouseId])
  @@index([tenantId, warehouseId, productId])
  @@map("lot_stock")
}

// Lots taken by a picking line; after shipping they record which lots left with the order.
model PickingItemLot {
  id            String @id @default(uuid())
  pickingItemId String
  lotId         String
  quantity      Int

  pickingItem PickingItem @relation(fields: [pickingItemId], references: [id], onDelete: Cascade)
  lot         Lot         @relation(fields: [lotId], references: [id])

  @@unique([pickingItemId, lotId])
  @@map("picking_item_lots")
}

enum PurchaseOrderStatus {
  open
  partially_received
  received
  closed
  cancelled
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String
  reference   String
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(open)
  expectedAt  DateTime?
  notes       String?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  closedAt    DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  supplier  Partner             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  receipts  Receipt[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantity         Int
  receivedQuantity Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_items")
}

enum ReceiptStatus {
  open
  completed
  cancelled
}

// Goods arriving at a warehouse, against a purchase order or blind. Stock moves only on completion.
model Receipt {
  id              String        @id @default(uuid())
  tenantId        String
  purchaseOrderId String?
  supplierId      String?
  warehouseId     String
  status          ReceiptStatus @default(open)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  completedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Partner?       @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  lines         ReceiptLine[]

  @@index([tenantId, status])
  @@map("receipts")
}

model ReceiptLine {
  id           String    @id @default(uuid())
  receiptId    String
  productId    String
  quantity     Int
  locationId   String?
  lotCode      String?
  lotExpiresAt DateTime?
  createdAt    DateTime  @default(now())

  receipt  Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([receiptId])
  @@map("receipt_lines")
}

enum CustomFieldEntity {
  product
  partner
  location
}

enum CustomFieldType {
  text
  number
  boolean
  date
  select
}

// Tenant-defined attribute; values live in the customFields JSON of the entity, keyed by `key`.
model CustomFieldDefinition {
  id        String            @id @default(uuid())
  tenantId  String
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType
  options   String[]          @default([])
  required  Boolean           @default(false)
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entity, key])
  @@map("custom_field_definitions")
}
