# Base de datos
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/wms_pro"
# Disposable database used by `npm run test:e2e` (never point it to real data)
TEST_DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/wms_pro_test"

# JWT — en producción la API no arranca con secretos de menos de 32 caracteres o de ejemplo.
# Genera cada uno con: openssl rand -base64 48
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambia-esto-tambien-en-produccion"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS="http://localhost:19006,http://localhost:8081,http://localhost:3000"

# Almacenamiento de fotos: "local" (UPLOAD_DIR, por defecto) o "s3" (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
# S3_BUCKET=wms-pro
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # solo para servicios compatibles con S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.tu-dominio.com                 # URL pública del bucket o CDN

# Correo (invitaciones): "log" imprime los mensajes en consola; "smtp" los envía
MAIL_DRIVER=log
# SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.com:465
MAIL_FROM="WMS Pro <no-reply@tu-dominio.com>"
# URL pública de la app web, usada en los enlaces de los correos
APP_URL=http://localhost:3000

# Trabajos en segundo plano: cada instancia de la API también los ejecuta salvo JOBS_WORKER=false
JOBS_WORKER=true
JOBS_CONCURRENCY=2
# JOBS_POLL_MS=1000
# JOBS_LOCK_SECONDS=300
