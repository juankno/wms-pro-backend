# Base de datos
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/wms_pro"

# JWT — cambia estos valores antes de ir a producción
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambia-esto-tambien-en-produccion"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# CORS — orígenes permitidos separados por coma
CORS_ORIGINS="http://localhost:19006,http://localhost:8081"
